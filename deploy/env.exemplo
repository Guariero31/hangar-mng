# Copie este arquivo para ".env" na raiz do projeto, no servidor:   cp deploy/env.exemplo .env
# NUNCA envie o .env para o GitHub (já está no .gitignore).

# Seu domínio, sem https://  (ex.: hangar.seudominio.com.br). O DNS tipo A deve apontar para o IP da VPS.
DOMAIN=

# Senha do banco e segredo das sessões: gere cada um com   openssl rand -hex 32
# (use só letras e números, sem símbolos)
DB_PASSWORD=
JWT_SECRET=

# ID do cliente criado no Google Cloud (termina em .apps.googleusercontent.com)
GOOGLE_CLIENT_ID=

# Seu e-mail do Google: entra direto como administrador. Vários: separe por vírgula.
ADMIN_EMAILS=

# true = novos cadastros esperam aprovação de um admin
REQUIRE_APPROVAL=true

# E-mails (boas-vindas, aprovado, reprovado). Deixe SMTP_HOST vazio para não enviar e-mails.
# Exemplo com Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=seu@gmail.com,
# SMTP_PASS=senha de app de 16 letras (Conta Google > Segurança > Senhas de app; exige verificação em 2 etapas).
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Opcional. Padrão: Hangar MNG <SMTP_USER>
MAIL_FROM=

# Discord: cole a URL secreta do webhook aqui; não publique este valor.
DISCORD_WEBHOOK_URL=
DISCORD_NOTIFICATIONS_ENABLED=true
