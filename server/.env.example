# =====================================================================
#  Configuração do servidor (copie para .env — o iniciar.bat faz isso)
# =====================================================================

# Porta da API
PORT=3001

# --- Banco de dados ---------------------------------------------------
# Vazio = usa o Postgres EMBUTIDO, salvo em server/data/pglite (não precisa instalar nada).
# Para usar um PostgreSQL instalado na sua máquina, preencha, por exemplo:
# DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/hangar
DATABASE_URL=

# --- Login com Google -------------------------------------------------
# Vazio = aparece o "login de desenvolvimento" (sem Google) na tela inicial.
# Crie em https://console.cloud.google.com → Credenciais → ID do cliente OAuth (Aplicativo da Web)
GOOGLE_CLIENT_ID=

# E-mails que viram admin automaticamente ao entrar (separados por vírgula)
ADMIN_EMAILS=

# Segredo que assina a sessão. Deixe VAZIO no uso local (o sistema gera um aleatório sozinho).
# Em produção é obrigatório: 32+ caracteres aleatórios. Gere com:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Em produção atrás de proxy/Cloudflare: quantos proxies existem na frente (0 = nenhum)
# TRUST_PROXY=1
# Endereço de escuta (padrão: só esta máquina em desenvolvimento)
# HOST=127.0.0.1

# Novos cadastros precisam de aprovação de um admin (padrão: ligado). Use false para liberar geral.
# REQUIRE_APPROVAL=false

# Força ligar/desligar o login de desenvolvimento (padrão: ligado quando não há GOOGLE_CLIENT_ID)
# DEV_LOGIN=false

# Cria pilotos de exemplo num banco vazio (padrão: só com o banco embutido)
# SEED_DEMO=false
